# Darklord Mech materials
# Texture convention:
#   base = albedo/diffuse
#   _n  = normal
#   _s  = specular
#   _g  = gloss/roughness-related map
#   _e  = emissive

newmtl darklord_mech_arm
Ka 1.0 1.0 1.0
Kd 1.0 1.0 1.0
Ks 0.5 0.5 0.5
Ns 32.0
